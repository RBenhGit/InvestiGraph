# Copy to .env and fill in. `.env` is gitignored — never commit real credentials.

# Which registered source a render uses by default; overridable per render with --source.
# One of: yfinance (free) | twelvedata (paid)
DATA_SOURCE=yfinance

# Required only when DATA_SOURCE=twelvedata (or --source twelvedata).
TWELVEDATA_API_KEY=
