# Copy to .env and fill in. `.env` is gitignored — never commit real credentials.

# Which registered source a render uses by default; overridable per render with --source.
# One of: yfinance (free) | twelvedata (paid)
DATA_SOURCE=yfinance

# Required only when DATA_SOURCE=twelvedata (or --source twelvedata).
TWELVEDATA_API_KEY=

# Yahoo analyst-consensus data (growth estimates, price targets) used by the valuation panel
# needs no key — it's a separate public endpoint, not gated by the above.

# Optional. Overrides where saved valuations are stored (default: history.json at the repo
# root, or data/evaluators/<name>.json per evaluator). Checked BEFORE the evaluator, so setting
# this collapses per-evaluator storage back into one shared file — see history/store.py.
# HISTORY_FILE_PATH=
